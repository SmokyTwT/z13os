[Unit]
Description=Smoky OS - asusd ne change plus le profil d'énergie (power-profiles-daemon s'en charge)
Documentation=file:///usr/share/doc/smokyos/refonte/decisions.md
# Deux gestionnaires qui changent le profil en même temps se le disputent (manuel d'asusctl,
# issue #724) : c'est ce qui laissait le PC en « Performance » sur batterie. Avant chaque
# démarrage d'asusd, ses trois réglages de profil sont remis à « false » s'ils ne le sont pas.
# La limite de charge et la carte graphique restent gérées par asusd.
Before=asusd.service
ConditionPathExists=/etc/asusd/asusd.ron

[Service]
Type=oneshot
ExecStart=/usr/libexec/smokyos/smoky-asusd-profils.sh

[Install]
WantedBy=multi-user.target
