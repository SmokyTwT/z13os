[Unit]
Description=Smoky OS - configuration au premier démarrage (Spotify, Rnote, mode GPU)
Wants=network-online.target
After=network-online.target supergfxd.service
ConditionPathExists=!/var/lib/z13os/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/z13os/firstboot.sh
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
