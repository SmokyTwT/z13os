[Unit]
Description=Smoky OS - applis Flatpak et réglages du premier démarrage
Wants=network-online.target
After=network-online.target supergfxd.service
# au plus 12 essais par démarrage (toutes les 2 min), puis on réessaie au prochain
StartLimitIntervalSec=1h
StartLimitBurst=12

[Service]
Type=oneshot
ExecStart=/usr/libexec/z13os/firstboot.sh
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
