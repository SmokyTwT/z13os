[Unit]
Description=Smoky OS - inactivité : écran éteint, verrouillage, veille
PartOf=graphical-session.target
After=smoky-bureau.service

[Service]
# Délais pris dans tes réglages (appli Smoky → Système, mêmes noms que sous GNOME) : écran éteint
# après l'inactivité choisie (5 min par défaut), verrouillage ensuite, veille sur batterie après
# 15 min. Une vidéo ou une visio empêche tout cela. Le bureau relance ce service quand tu changes
# un délai.
ExecStart=/usr/bin/smoky-bureau-cmd veille-lancer
Restart=on-failure
RestartSec=2
Slice=session.slice
