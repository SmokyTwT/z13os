[Unit]
Description=Smoky OS - clavier à l'écran (bouton de la barre ; seul dans un champ de texte en mode tablette ou clavier détaché)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Clavier maison (smokybureau/clavier_ecran.py) : caché tant qu'on ne l'appelle pas, il tape par un
# clavier virtuel Wayland. smoky-adaptive règle org.gnome.desktop.a11y.applications
# screen-keyboard-enabled (mode tablette ou clavier détaché) : il apparaît alors seul.
Type=dbus
BusName=fr.smoky.Clavier
ExecStart=/usr/libexec/smokyos/smoky-clavier-ecran.py
Restart=on-failure
RestartSec=3
Slice=session.slice
