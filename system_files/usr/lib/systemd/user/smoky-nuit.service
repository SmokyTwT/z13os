[Unit]
Description=Smoky OS - éclairage du soir (couleurs plus chaudes la nuit)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Allumé par le bureau Smoky si l'éclairage du soir est activé (réglages rapides ou appli Smoky) ;
# température et horaires pris dans tes réglages (coucher et lever du soleil, ou heures fixes)
ExecStart=/usr/bin/smoky-bureau-cmd nuit-lancer
Restart=on-failure
RestartSec=3
Slice=session.slice
