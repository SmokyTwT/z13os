[Unit]
Description=Smoky OS - barre, dock, lanceur, notifications et réglages rapides
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=fr.smoky.Bureau
ExecStart=/usr/bin/python3 -I /usr/libexec/smokyos/smoky-bureau.py
Restart=on-failure
RestartSec=1
Slice=session.slice
