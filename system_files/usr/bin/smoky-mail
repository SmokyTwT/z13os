#!/usr/bin/env bash
# Lance Smoky Mail : démarre le serveur local si besoin, puis ouvre l'appli.
# Chemin « /mail » : Chrome nomme la fenêtre « chrome-127.0.0.1__mail-Default » (voir le .desktop),
# distincte de Smoky Notes.
PORT=47815
SRV=
if ! (exec 3<>/dev/tcp/127.0.0.1/$PORT) 2>/dev/null; then
  nohup /usr/bin/python3 /usr/libexec/smokymail/server.py >/dev/null 2>&1 &
  SRV=$!
  for _ in $(seq 50); do (exec 3<>/dev/tcp/127.0.0.1/$PORT) 2>/dev/null && break; sleep 0.1; done
fi
PROFILE="$HOME/.config/smoky-mail-chrome"
/usr/bin/google-chrome-stable --ozone-platform-hint=auto --force-dark-mode --start-maximized --enable-wayland-ime \
  --app="http://127.0.0.1:$PORT/mail" --class=smoky-mail --no-first-run --no-default-browser-check --user-data-dir="$PROFILE" "$@"
# Batterie : le serveur lancé ici s'arrête quand la dernière fenêtre de l'appli se ferme
# (Chrome reste dans cette commande tant que l'appli est ouverte).
if [ -n "$SRV" ] && ! pgrep -f -- "--user-data-dir=$PROFILE" >/dev/null; then
  kill "$SRV" 2>/dev/null
fi
