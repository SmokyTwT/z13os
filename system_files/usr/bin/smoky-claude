#!/usr/bin/env bash
# Ouvre Claude Code dans une nouvelle fenêtre de terminal (dock, Super + C).
RUN='claude || { echo; read -rp "Appuie sur Entrée pour fermer."; }'
if command -v ptyxis >/dev/null; then
  exec ptyxis --new-window -- bash -lc "$RUN"
elif command -v xdg-terminal-exec >/dev/null; then
  exec xdg-terminal-exec bash -lc "$RUN"
elif command -v kgx >/dev/null; then
  exec kgx -- bash -lc "$RUN"
else
  exec gnome-terminal -- bash -lc "$RUN"
fi
