#!/usr/bin/env bash
# Ouvre le terminal de Smoky OS (dock, Super + C) : Claude Code y démarre tout seul
# (voir /etc/profile.d/smoky-claude.sh).
if command -v ptyxis >/dev/null; then
  exec ptyxis --new-window
elif command -v xdg-terminal-exec >/dev/null; then
  exec xdg-terminal-exec
elif command -v kgx >/dev/null; then
  exec kgx
else
  exec gnome-terminal
fi
