#!/usr/bin/env bash
# Lance Smoky Center : démarre le serveur local si besoin, puis ouvre l'appli.
# Adresse « localhost » (et non 127.0.0.1) : Chrome nomme la fenêtre d'après l'hôte et le
# chemin, ce qui la distingue de Smoky Notes (chrome-localhost__-Default, voir le .desktop).
PORT=47814
if ! (exec 3<>/dev/tcp/127.0.0.1/$PORT) 2>/dev/null; then
  nohup /usr/bin/python3 /usr/libexec/smokyos/smoky-center.py >/dev/null 2>&1 &
  for _ in $(seq 50); do (exec 3<>/dev/tcp/127.0.0.1/$PORT) 2>/dev/null && break; sleep 0.1; done
fi
exec /usr/bin/google-chrome-stable --ozone-platform-hint=auto --force-dark-mode --enable-wayland-ime \
  --app="http://localhost:$PORT/" --class=smoky-center --window-size=1100,820 --no-first-run --no-default-browser-check --user-data-dir="$HOME/.config/smoky-center-chrome" "$@"
