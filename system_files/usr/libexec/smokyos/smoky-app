#!/usr/bin/env bash
# Lanceur commun des applis Smoky (Notes, Center, Mail, Agenda).
#   smoky-app notes|center|mail|agenda [options de l'appli] [options de Chrome…]
# Démarre le serveur local de l'appli si besoin, ouvre sa fenêtre, puis arrête le serveur
# quand la dernière fenêtre de l'appli se ferme (rien ne tourne pour rien : batterie).
#
# Ne pas changer les adresses ni les dossiers ci-dessous à la légère :
#  - Chrome nomme chaque fenêtre d'après l'hôte et le chemin (« chrome-127.0.0.1__mail-Default ») ;
#    c'est ce nom que porte StartupWMClass dans les fichiers .desktop, sinon l'icône du dock se dédouble.
#    D'où « localhost » pour Smoky Center et un chemin propre à Mail et Agenda.
#  - le dossier de profil garde les autorisations de l'appli (micro de Smoky Notes…).
app="${1:-}"
shift || true

HOTE=127.0.0.1
CHEMIN=/
FENETRE=(--start-maximized)
case "$app" in
  notes)  PORT=47813; SERVEUR=/usr/libexec/smokynotes/server.py ;;
  center) PORT=47814; SERVEUR=/usr/libexec/smokyos/smoky-center.py; HOTE=localhost; FENETRE=("--window-size=1100,820") ;;
  mail)   PORT=47815; SERVEUR=/usr/libexec/smokymail/server.py;  CHEMIN=/mail ;;
  agenda) PORT=47816; SERVEUR=/usr/libexec/smokyagenda/server.py; CHEMIN=/agenda ;;
  *) echo "usage : $0 notes|center|mail|agenda [options]" >&2; exit 2 ;;
esac

# smoky-notes --classeur NOM : ouvre directement le classeur d'une matière (depuis Smoky Agenda)
SUITE=
if [ "$app" = notes ] && [ "${1:-}" = "--classeur" ] && [ -n "${2:-}" ]; then
  SUITE="&f=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1][:60], safe=""))' "$2")"
  shift 2
fi

ouvert() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; }

SRV=
JETON="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/smoky-$app.token"
if ! ouvert; then
  rm -f "$JETON"     # le serveur lancé ici écrit un nouveau code d'accès
  nohup /usr/bin/python3 "$SERVEUR" >/dev/null 2>&1 &
  SRV=$!
  for _ in $(seq 50); do ouvert && break; sleep 0.1; done
  for _ in $(seq 30); do [ -s "$JETON" ] && break; sleep 0.1; done
fi

PROFIL="$HOME/.config/smoky-$app-chrome"
/usr/bin/google-chrome-stable --ozone-platform-hint=auto --force-dark-mode --enable-wayland-ime "${FENETRE[@]}" \
  --app="http://$HOTE:$PORT$CHEMIN#k=$(cat "$JETON" 2>/dev/null)$SUITE" --class="smoky-$app" \
  --no-first-run --no-default-browser-check --user-data-dir="$PROFIL" "$@"

# Chrome reste dans la commande ci-dessus tant que l'appli est ouverte. Le serveur lancé ici
# s'arrête quand plus aucune fenêtre de l'appli n'existe.
if [ -n "$SRV" ] && ! pgrep -f -- "--user-data-dir=$PROFIL" >/dev/null; then
  kill "$SRV" 2>/dev/null
fi
