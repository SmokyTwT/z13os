// Smoky OS : l'utilisateur de la session active peut, sans mot de passe, démarrer/arrêter
// le mode concentration (smoky-focus@N.service) et redémarrer sur Windows
// ou dans les réglages UEFI (smoky-windows.service, smoky-firmware.service : l'équivalent du
// bouton « Redémarrer »). Rien d'autre.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.local && subject.active &&
        /^smoky-focus@[0-9]{1,3}\.service$/.test(action.lookup("unit") || "") &&
        ["start", "stop"].indexOf(action.lookup("verb")) >= 0) {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.local && subject.active &&
        ["smoky-windows.service", "smoky-firmware.service"].indexOf(action.lookup("unit")) >= 0 &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
